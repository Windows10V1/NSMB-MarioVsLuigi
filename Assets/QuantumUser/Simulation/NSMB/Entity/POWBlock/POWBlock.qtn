component POWBlock {
	byte MaxUses;

	[ExcludeFromPrototype] byte Uses;
	[ExcludeFromPrototype] EntityRef SpawnOwner;
	[ExcludeFromPrototype] EntityRef Activator;
	[ExcludeFromPrototype] bool WasThrown;
	[ExcludeFromPrototype] bool CanGroundActivate;
	[ExcludeFromPrototype] bool HasSpawnLanded;
}

event POWBlockActivated {
	EntityRef Entity;
	EntityRef Activator;
	FPVector2 Position;
	byte Uses;
}

event POWBlockSpawnLanded {
	EntityRef Entity;
	FPVector2 Position;
}
