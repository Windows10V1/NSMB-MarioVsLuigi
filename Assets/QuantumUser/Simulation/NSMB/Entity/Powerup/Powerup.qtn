component Powerup {
	bool FacingRight;

	[ExcludeFromPrototype] FPVector2 AnimationCurveOrigin;
	[ExcludeFromPrototype] FP AnimationCurveTimer;
}

signal OnMarioPlayerCollectedPowerup(EntityRef mario, EntityRef powerup);

enum PowerupState : Byte {
    NoPowerup,
    MiniMushroom,
    Mushroom,
    GoldFlower,
    BoomerangFlower,
    FireFlower,
    PenguinSuit,
    FrogSuit,
    PropellerMushroom,
    BuilderSuit,
    BlueShell,
    HammerSuit,
    SuperAcorn,
    CloudFlower,
    SuperBallFlower,
    MegaMushroom
}

enum PowerupSpawnReason : Byte {
	PowerupBlock,
	Coins,
	BlueKoopa,
	Other
}

enum PowerupReserveResult : Byte {
	KeepOldReserveNew,
    CollectNewReserveOld,
    CollectNewIgnoreOld,
}